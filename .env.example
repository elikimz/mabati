# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver for async, psycopg2 for Alembic)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── JWT Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Mabati Roofing API
APP_VERSION=1.0.0
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or ["*"] for all
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","https://mrmkenya.online","https://www.mrmkenya.online"]
